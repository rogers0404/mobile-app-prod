# AWS Environment Configuration Template
# Copy this to .env and fill in your actual values

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-12-digit-account-id
AWS_PROFILE=default

# ============================================
# Application Configuration
# ============================================
ENVIRONMENT=production
APP_NAME=trip-ride-share
LOG_LEVEL=INFO
DEBUG=false

# ============================================
# API Configuration
# ============================================
API_PORT=3000
API_DOMAIN=api.trip.app
API_VERSION=v1
CORS_ORIGINS=https://app.trip.app,https://www.trip.app

# ============================================
# Database Configuration
# ============================================
# DynamoDB settings
DYNAMODB_TABLE_PREFIX=prod_
DYNAMODB_REGION=us-east-1
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST
DYNAMODB_READ_CAPACITY=100
DYNAMODB_WRITE_CAPACITY=50

# Optional: PostgreSQL (alternative to DynamoDB)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=trip_app
DATABASE_USER=
DATABASE_PASSWORD=

# Optional: Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# Cognito Configuration
# ============================================
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_DOMAIN=trip-app
COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# Third-party Services
# ============================================

# PayPal Configuration
PAYPAL_MODE=sandbox
# sandbox: https://api-m.sandbox.paypal.com
# production: https://api-m.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Stripe Configuration (Optional)
STRIPE_API_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_RESTRICTION=
# Optional: Restrict to specific websites/apps
# format: https://developers.google.com/maps/documentation/maps-static/overview#key_restrictions

# Twilio Configuration (Optional - for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration (Optional - for Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@trip.app

# ============================================
# S3 Configuration
# ============================================
S3_BUCKET_DOCUMENTS=trip-app-documents
S3_BUCKET_LOGS=trip-app-logs
S3_REGION=us-east-1
S3_UPLOAD_FOLDER_DRIVERS=driver-documents
S3_UPLOAD_FOLDER_RECEIPTS=receipts
S3_UPLOAD_FOLDER_PROFILES=profile-pictures
S3_PRESIGNED_URL_EXPIRATION=3600

# ============================================
# WebSocket Configuration
# ============================================
WEBSOCKET_API_ID=xxxxxxxxxx
WEBSOCKET_STAGE=prod
WEBSOCKET_CONNECT_TIMEOUT=10000
WEBSOCKET_MAX_MESSAGE_SIZE=65536

# ============================================
# Security Configuration
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_REFRESH_ENABLED=true

# API Key for internal services
API_KEY=your-api-key-for-internal-services

# CORS Settings
CORS_ENABLED=true
CORS_MAX_AGE=3600
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=100

# ============================================
# Business Logic Configuration
# ============================================

# Pricing Configuration
BASE_FARE=2.00
PER_MILE_RATE=1.50
MINIMUM_FARE=5.00
SERVICE_FEE_PERCENTAGE=15
DRIVER_COMMISSION_PERCENTAGE=75

# Ride Configuration
RIDE_REQUEST_TIMEOUT_SECONDS=30
DRIVER_SEARCH_RADIUS_MILES=5
MAX_DRIVER_ACCEPTANCE_TIME=120
RIDE_COMPLETION_GRACE_PERIOD=300

# Driver Configuration
DRIVER_RATING_THRESHOLD=4.5
DRIVER_MAX_CANCELLATIONS=5
DRIVER_BACKGROUND_CHECK_REQUIRED=true
DRIVER_DOCUMENT_EXPIRY_DAYS=365

# User Configuration
RIDER_PHONE_VERIFICATION_REQUIRED=false
RIDER_EMAIL_VERIFICATION_REQUIRED=true
RIDER_MAX_CONCURRENT_RIDES=1

# ============================================
# Monitoring & Logging
# ============================================
CLOUDWATCH_LOG_LEVEL=INFO
CLOUDWATCH_RETENTION_DAYS=30
CLOUDWATCH_ENABLED=true
XRAY_ENABLED=true
XRAY_SAMPLING_RATE=0.1

# Sentry Configuration (Optional - Error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1

# DataDog Configuration (Optional - APM)
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ============================================
# Notification Configuration
# ============================================
NOTIFICATION_EMAIL_FROM=noreply@trip.app
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true

# Firebase Cloud Messaging (for push notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ============================================
# Features (Feature Flags)
# ============================================
FEATURE_SCHEDULED_RIDES=false
FEATURE_RIDE_SHARING=false
FEATURE_DRIVER_PREFERENCES=false
FEATURE_ADVANCE_BOOKING=false
FEATURE_CORPORATE_ACCOUNTS=false
FEATURE_LOYALTY_PROGRAM=false

# ============================================
# Testing & Development
# ============================================
TESTING_MODE=false
MOCK_PAYMENTS=false
MOCK_MAPS=false
MOCK_GPS=false

# ============================================
# Secrets Manager (AWS)
# ============================================
SECRETS_MANAGER_ENABLED=true
SECRETS_MANAGER_KMS_KEY_ID=alias/aws/secretsmanager
SECRET_PAYPAL_CREDENTIALS=paypal-credentials
SECRET_STRIPE_CREDENTIALS=stripe-credentials
SECRET_GOOGLE_MAPS_KEY=google-maps-api-key

# ============================================
# Session & Cache
# ============================================
SESSION_TIMEOUT_MINUTES=30
SESSION_EXTENSION_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE_MB=100

# ============================================
# Email Templates
# ============================================
EMAIL_TEMPLATE_CONFIRMATION=confirmation.html
EMAIL_TEMPLATE_RECEIPT=receipt.html
EMAIL_TEMPLATE_PROMOTION=promotion.html

# ============================================
# Optional: Multi-Region Setup
# ============================================
SECONDARY_REGION=us-west-2
MULTI_REGION_ENABLED=false
GLOBAL_TABLES_ENABLED=false

# ============================================
# Optional: CDN Configuration
# ============================================
CLOUDFRONT_ENABLED=true
CLOUDFRONT_DOMAIN_NAME=d1234567.cloudfront.net
CDN_CACHE_TTL=86400

# ============================================
# Deployment Tracking
# ============================================
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_DATE=2026-11-19
GIT_COMMIT_SHA=
GIT_BRANCH=main
