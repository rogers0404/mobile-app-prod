# Copy to .env and fill locally. Never put private server credentials here.
EXPO_PUBLIC_APP_ENV=development
# Leave empty for automatic emulator / Expo host detection.
EXPO_PUBLIC_BACKEND_URL=
# Public browser/client key; review direct Geocoding use before restricting it.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Separate native SDK keys. These are embedded in native app binaries.
# Android: restrict by package name + signing certificate and allowed APIs.
GOOGLE_MAPS_ANDROID_API_KEY=
# iOS: restrict by bundle identifier and allowed APIs (if using Google Maps).
GOOGLE_MAPS_IOS_API_KEY=
